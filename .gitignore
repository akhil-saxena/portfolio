.tmp/

# phase 0 throwaway playground
# Deleted at Phase 0 exit (plan 17). Gitignored so it leaves no history to be
# tempted by — the D-02 scope fence depends on the playground not surviving as
# the Phase 2 foundation. Also keeps the 2.4 MB design-system tarball and
# node_modules out of the repo.
.playground/

# cloudflare local dev secrets (see .dev.vars.example)
.dev.vars
!.dev.vars.example

# live-run scratch (plan 04-10 Task 4)
# The before-state SHA and the new record's id are written to FILES rather than exported,
# because the action and its verify block are separate shell invocations and exported state
# does not survive between them. They are run scratch, not deliverables.
.live-run-before-sha
.live-run-photo-id

# the six-class audit's Playwright scratch (plan 05-15)
# `npm run audit:public` writes a trace/error-context directory here on any failure. The audit's
# deliverables are `05-AUDIT.md` and the 42 committed captures in the phase directory; this is the
# runner's own scratch and belongs to whoever last ran it.
test-results/
playwright-report/

# the Lighthouse run's reports (`npm run audit:lighthouse`)
# The deliverable is the table in `05-AUDIT.md` §20 and the closures in `05-UI-SPEC.md` §7.2/§9.2;
# this is the runner's own record and belongs to whoever last ran it. Biome does not read this
# file (`vcs.useIgnoreFile: false`), so the directory is excluded in `biome.json` too.
lighthouse-report/
