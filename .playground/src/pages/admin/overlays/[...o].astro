									</span>
								</div>
								<ul class="ov-changes ov-changes-danger">
									{s.changes.map((c) => (
										<li>{c}</li>
									))}
								</ul>
							</li>
						))}
					</ul>

					{/* THE GUARD FIELD — TypeToConfirm's own mechanism, prototyped. */}
					<div class="ov-guard">
						<label class="ov-guard-label" for="guard-word">
							Type <strong>{fx.discardAll.guardWord}</strong> to confirm
						</label>
						<input
							id="guard-word"
							class="ds-atom-textinput ov-guard-input"
							type="text"
							value=""
