	/* == The RichText island's chrome ====================================== */
	.rtb-root {
		display: grid;
		gap: var(--space-4);
	}
	.rtb-editor {
		max-width: 100%;
	}
	.rtb-panel {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-3);
		border: 1px solid var(--rule);
		border-radius: var(--radius-md);
		background: var(--cream-2);
	}
	.rtb-panel[data-evidence="g-4"] {
		border-color: var(--wire);
		border-left-width: 2px;
	}
	.rtb-code {
		margin: 0;
		padding: var(--space-2);
		overflow-x: auto;
		font-family: var(--mono);
		font-size: var(--text-2xs);
		line-height: 1.45;
		color: var(--ink-2);
		background: var(--cream-3);
		border-radius: var(--radius-sm);
		white-space: pre;
	}
	.rtb-two {
		display: grid;
		gap: var(--space-3);
	}
	@media (min-width: 673px) {
		.rtb-two {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.rtb-half {
		display: grid;
		gap: var(--space-1);
		min-width: 0;
	}
	.rtb-loss {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}
	.rtb-rendered {
		margin: 0;
		font-size: var(--text-sm);
		line-height: var(--lh-relaxed);
		color: var(--ink-2);
	}
	.rtb-rendered strong {
		font-weight: 600;
		color: var(--ink);
	}

	/* == Review chrome ===================================================== */
	.rs-review {
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-8);
		padding: var(--space-3) var(--space-4);
		border: 1px dashed var(--wire);
		border-radius: var(--radius-md);
	}
	.rs-review-line {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: 0;
	}
	.rs-review-link {
		font-family: var(--mono);
		font-size: var(--text-xs);
		color: var(--ink-3);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
		display: inline-flex;
		align-items: center;
	}
	.rs-review-link[data-on="true"] {
		color: var(--ink);
		border-bottom-color: var(--wire);
	}
	.rs-review-note {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--ink-3);
	}

	/* == The 44px floor, every coarse-pointer class ========================
	   Five of the six device classes in the responsive contract are coarse
	   pointer, so the floor is the common case, and it sits on the HIT AREA
	   rather than the painted control. The design system's own inputs, selects
	   and buttons are carried by density-compact.css; these are mine.

	   `.ds-atom-sortable-item` is here because SortableItem spreads dnd-kit's
	   listeners onto the item wrapper, so the ROW is the target. The RichText
	   editing surface is a contenteditable textbox, which needs the floor for
	   the same reason a textarea does — and richtext.css sets a min-height in a
	   raw length, so nothing token-shaped reaches it. */
	@media (pointer: coarse) {
		.rs-review-link,
		.sst-row,
		.ds-atom-sortable-item,
		.rs-present,
		.rs-pdf-row .ds-atom-link {
			min-height: 44px;
		}
		.ds-atom-richtext-editor,
		.ds-atom-richtext .ProseMirror {
			min-height: 44px;
		}
	}
</style>
