{
  "name": "akhilsaxena-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "npm run bootstrap:local && wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "wrangler types && astro preview",
    "check": "biome check . && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "typecheck": "astro check",
    "bootstrap:local": "node scripts/bootstrap-local-env.mjs",
    "test": "vitest run",
    "test:workers": "vitest run --project workers",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/react": "^6.0.2",
    "astro": "^7.2.2",
    "jose": "^6.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.9",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  }
}
