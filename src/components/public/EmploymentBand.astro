---
/**
 * The employment band on `/work` — §10 item 4. Plan 05-09, task 1.
 *
 * ================================================================================================
 * WHAT IT IS
 * ================================================================================================
 *
 * One hairline-separated row per record in `resume.experience`: company, role · period, and the
 * right-aligned mono metric. It is the SAME three records `/resume` renders through
 * `ResumeEntry.astro`, shown as evidence rather than as a history — so the arrangement mirrors that
 * component deliberately, and the metric takes exactly the treatment plan 05-10 gave it there
 * (§4.3 entry 2: the value in `--ochre-d-strong`, the label on the ink ramp, IBM Plex Mono
 * `--text-xs` with `--ls-wide`). Two routes showing one fact must not show it two ways.
 *
 * ================================================================================================
 * THREE THINGS THIS COMPONENT DELIBERATELY DOES NOT DO
 * ================================================================================================
 *
 * 1. IT DOES NOT FORMAT A DATE. `formatPeriod()` in `src/lib/period.ts` is the ONE definition of
 *    that invariant — it is what `ResumeSchema`'s refinement asks, and §10 says in as many words
 *    "do not format dates in a page". `ResumeEntry.astro` reaches for the same function for the
 *    same reason; a second formatter would be a second answer to "has this role ended?".
 *
 * 2. IT DOES NOT WRITE A COUNT. §10 says "three employment rows"; this file says
 *    `entries.map(...)`. No number of rows is rendered or asserted anywhere — not here, not in
 *    `work.astro`, not in `work.css`, not in `test/public/work.node.test.ts`; the figure in the
 *    sentence above is prose about the fixture, and nothing reads it. A hardcoded record count
 *    turned `main` red in Phase 4 the moment content changed, and `data/resume.json` is reviewed
 *    content Akhil edits. It DOES refuse an empty list, because a band that rendered nothing
 *    would look like a design choice.
 *
 * 3. IT WRITES NO FIGURE OF ITS OWN. `entry.metric` is read whole. Its three values on disk are
 *    PLACEHOLDERS Akhil intends to revise (OQ-1b), so nothing here, in the stylesheet or in the
 *    suite asserts on their wording — revising them changes rendered text and nothing else. What
 *    WILL fire is `scripts/assert-no-unresolved-placeholders.mjs`, if a `{{…}}` token is ever
 *    stored and reaches `dist/`. That is the designed behaviour, not a break.
 *
 * ================================================================================================
 * THE 1080px CAP COMES FROM `PAGE_MAX.band`, THROUGH A CUSTOM PROPERTY
 * ================================================================================================
 *
 * §2.2 caps the band at 1080 inside the 1280 page (J3 CONFIRMED: *"it's fine"*). That number is
 * `PAGE_MAX.band` in `src/lib/layout-ladder.ts` and it is imported here rather than retyped in
 * `work.css`, because two numbers that agree today are a duplication rather than a contract —
 * which is the entire argument of `scripts/assert-gutter-ladder.mjs`.
 *
 * It arrives as an inline custom property because a media-query-free `max-width` is the only thing
 * CSS needs and CSS cannot import TypeScript. The alternative — reusing the shell's `.pub-max-band`
 * class — was REJECTED: that rule also sets `margin-inline: auto`, which would centre the band and
 * inset its left edge 100px from the header and the card grid above and below it. A cap that
 * shortens the measure is the reviewed intent; a cap that moves the left margin is not.
 */

import { PAGE_MAX } from '../../lib/layout-ladder';
import { formatPeriod } from '../../lib/period';
import type { ExperienceEntry } from '../../schemas';

interface Props {
  entries: readonly ExperienceEntry[];
}

const { entries } = Astro.props;

/*
 * ANTI-VACUITY, in the renderer rather than only in a check. `ResumeSchema` already refuses an
 * empty `experience` array, so this is unreachable through the committed path — it is here because
 * the failure it guards is silent: a band that rendered zero rows would ship as a page with an
 * eyebrow and nothing under it, and every artefact check that counts rendered rows against the
 * stored count would pass, 0 === 0.
 */
if (entries.length === 0) {
  throw new Error(
    'EmploymentBand: rendered with no experience records. The band would ship as an eyebrow with ' +
      'nothing under it, and a rendered-vs-stored count check would pass 0 against 0. ' +
      'data/resume.json is the source; ResumeSchema refuses an empty list upstream of this.'
  );
}

/*
 * Computed here rather than inline in the template so a throw from an incoherent record has a
 * frame in this file. `formatPeriod` refuses a range that is both open and closed; the schema
 * refuses the same shape earlier, so reaching this line with a bad record means the schema was
 * bypassed and the page should not render at all.
 */
const rows = entries.map((entry) => ({ entry, period: formatPeriod(entry) }));
---

<div class="wk-band" style={`--wk-band-max: ${PAGE_MAX.band}px`}>
  {
    rows.map(({ entry, period }) => (
      <article class="wk-row">
        <div class="wk-identity">
          <h3 class="wk-company">{entry.company}</h3>
          <p class="wk-role">
            {entry.role} · {period}
          </p>
        </div>
        <p class="wk-metric">
          <span class="wk-metric-value">{entry.metric.value}</span>
          <span class="wk-metric-label">{entry.metric.label}</span>
        </p>
      </article>
    ))
  }
</div>
