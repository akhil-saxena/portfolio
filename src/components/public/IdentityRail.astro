---

import { Link } from '@akhil-saxena/design-system/components/Link';

import homeConfig from '../../../data/home_config.json';
import type { ExperienceEntry } from '../../schemas';
import { EN_DASH, PRESENT } from '../../lib/period';
import SocialIcons from './SocialIcons.astro';

interface Props {
  readonly entries: ReadonlyArray<ExperienceEntry>;
  readonly crossLink?: { readonly href: string; readonly label: string };
  readonly owns?: 'identity' | 'experience';
}

const { entries, crossLink, owns = 'identity' } = Astro.props;
const ownsIdentity = owns === 'identity';

const hasHeadline = Astro.slots.has('headline');

const YEAR_SEPARATOR = ` ${EN_DASH} `;

const yearsOf = (entry: ExperienceEntry): string =>
  entry.isPresent
    ? `${entry.startYear}${YEAR_SEPARATOR}${PRESENT}`
    : `${entry.startYear}${YEAR_SEPARATOR}${entry.endYear}`;

const roles = entries.map((entry) => ({ entry, years: yearsOf(entry) }));
---

<aside class="wk-rail">
  {
  }
  {
    ownsIdentity && (
      <Link
        href="/"
        variant="quiet"
        className="wk-rail-brand"
        style={{ fontFamily: 'var(--font-serif)' }}
      >
        {homeConfig.title}
      </Link>
    )
  }
  {hasHeadline && <slot name="headline" />}

  <div class:list={["wk-rail-head", { "is-first": !ownsIdentity && !hasHeadline }]}>
    <h2 class="wk-eyebrow">Experience</h2>
    {
    }
    {
    }
    <Link href="/resume.pdf" variant="quiet" className="wk-rail-resume">
      {
      }
      Resume (PDF)
      <span class="wk-rail-resume-disc">
        <svg
          class="wk-rail-resume-arrow"
          width="10"
          height="10"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 4v14" />
          <path d="M6 12l6 6 6-6" />
        </svg>
      </span>
    </Link>
  </div>

  <ol class="wk-timeline">
    {
      roles.map(({ entry, years }, index) => (
        <li class={index === 0 ? 'wk-role-item is-current' : 'wk-role-item'}>
          {
          }
          <span class="wk-role-dot" aria-hidden="true"></span>
          <h3 class="wk-role-company">{entry.company}</h3>
          <p class="wk-role-title">{entry.role}</p>
          <p class="wk-role-years">{years}</p>
          {
          }
        </li>
      ))
    }
  </ol>

  {
    ownsIdentity && (
    <div class="wk-rail-foot">
      {
      }
      <div class="wk-rail-social">
        {
          homeConfig.socialLinks.map((link) => {
            const external = !link.url.startsWith('mailto:');
            return (
              <a
                class="pub-social-link"
                href={link.url}
                aria-label={link.label}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <SocialIcons icon={link.icon} />
              </a>
            );
          })
        }
      </div>
      {crossLink && (
        <Link href={crossLink.href} variant="quiet" className="wk-rail-cross">{crossLink.label}</Link>
      )}
    </div>
    )
  }
</aside>
