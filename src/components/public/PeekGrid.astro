---
import homeConfig from '../../../data/home_config.json';
import manifest from '../../../data/portfolio_images.json';
import { ACT_ONE_MAX, GUTTER_RUNGS, PEEK_GAP } from '../../lib/layout-ladder';
import { srcsetFor } from '../../lib/photo-srcset';
import { DEFAULT_FOCAL_POINT } from '../../schemas/photo';

const PEEK_COLUMNS: ReadonlyArray<{ minWidth: number | null; columns: number }> = [
  { minWidth: null, columns: 2 },
  { minWidth: 673, columns: 3 },
];

function peekColumnsAt(width: number | null): number {
  let inForce = PEEK_COLUMNS[0].columns;
  for (const step of PEEK_COLUMNS) {
    if (step.minWidth === null) continue;
    if (width !== null && width >= step.minWidth) inForce = step.columns;
  }
  return inForce;
}

function peekSizes(): string {
  const conditioned = GUTTER_RUNGS.filter((rung) => rung.minWidth !== null);
  const pad = Math.max(...conditioned.map((rung) => String(rung.minWidth).length));
  const descending = [...conditioned].reverse();
  const widest = descending[0];

  const clauses = descending.map((rung) => {
    const cols = peekColumnsAt(rung.minWidth);
    const content = rung === widest ? `min(100vw, ${ACT_ONE_MAX}px)` : '100vw';
    const gutterTerm = 2 * rung.px;
    const gapTerm = (cols - 1) * PEEK_GAP.px;
    const condition = `(min-width:${String(rung.minWidth).padStart(pad)}px)`;
    return `${condition} calc((${content} - ${gutterTerm}px - ${gapTerm}px) / ${cols})`;
  });

  const base = GUTTER_RUNGS.find((rung) => rung.minWidth === null);
  if (!base) {
    throw new Error(
      'PeekGrid: GUTTER_RUNGS has no unconditioned base rung, so there is no fallback clause. A ' +
        'viewport below the first breakpoint would get no match and the browser would fall back ' +
        'to 100vw, which is wider than the gutters allow.'
    );
  }
  const baseCols = peekColumnsAt(null);
  clauses.push(
    `calc((100vw - ${2 * base.px}px - ${(baseCols - 1) * PEEK_GAP.px}px) / ${baseCols})`
  );

  return clauses.join(', ');
}

const SIZES = peekSizes();

const peekPhotos = homeConfig.peekIds.map((id) => {
  const photo = manifest.find((record) => record.id === id);
  if (!photo) {
    throw new Error(
      `PeekGrid: home_config.peekIds names "${id}", which is not in data/portfolio_images.json. ` +
        'Rendering the other five would put a portfolio on the site\'s primary route that is ' +
        'missing a photograph its owner chose, with no error anywhere.'
    );
  }
  return photo;
});

const positions = homeConfig.peekPositions as Record<string, string | undefined>;

---

<section class="hm-peek" aria-label="Photographs">
  <ul class="hm-peek-grid" data-peek-count={peekPhotos.length} data-peek-total={manifest.length}>
    {
      peekPhotos.map((photo) => (
        <li class="hm-peek-item">
          <div
            class="hm-tile"
            style={`background-image: url("${photo.urls.thumb}")`}
          >
            <img
              src={photo.urls.medium}
              srcset={srcsetFor(photo)}
              sizes={SIZES}
              alt={photo.alt}
              loading="eager"
              decoding="async"
              style={`object-position: ${positions[photo.id] ?? DEFAULT_FOCAL_POINT}`}
            />
            {
            }
          </div>
        </li>
      ))
    }
  </ul>
</section>
