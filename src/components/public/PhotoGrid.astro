---

import PhotoTile from './PhotoTile.astro';
import { GRID_CATEGORY_ATTRIBUTE, GRID_ID, isVisibleIn } from '../../lib/photo-filter';
import { sizesFor } from '../../lib/photo-srcset';
import type { PhotoIdentity, PhotoSources } from '../../lib/photo-srcset';

const EAGER_TILE_COUNT = 4;

type GalleryPhoto = PhotoIdentity &
  PhotoSources & {
    readonly alt: string;
    readonly title: string;
    readonly urls: Readonly<Record<string, string>>;
  };

interface Props {
  photos: readonly GalleryPhoto[];
  columns: number;
  activeCategory: string;
}

const { photos, columns, activeCategory } = Astro.props;

if (photos.length === 0) {
  throw new Error(
    'PhotoGrid: rendered with zero photographs. That is not a content state — §13.2 gives the ' +
      'empty gallery its own copy, and the route is what chooses between the two. An empty grid ' +
      'here would ship a page that is silently blank instead of one that explains itself.'
  );
}

const sizes = sizesFor(columns);

type GalleryTile = {
  readonly photo: GalleryPhoto;
  readonly hidden: boolean;
  readonly eager: boolean;
  readonly index: number;
};

let eagerRemaining = EAGER_TILE_COUNT;
const tiles: readonly GalleryTile[] = photos.map((photo: GalleryPhoto, index: number) => {
  const hidden = !isVisibleIn(photo.category, activeCategory);
  const eager = !hidden && eagerRemaining > 0;
  if (eager) eagerRemaining -= 1;
  return { photo, hidden, eager, index };
});
---

<div
  id={GRID_ID}
  class="ph-masonry"
  data-cols={String(columns)}
  {...{ [GRID_CATEGORY_ATTRIBUTE]: activeCategory }}
>
  {
    tiles.map((tile: GalleryTile) => (
      <PhotoTile
        photo={tile.photo}
        sizes={sizes}
        eager={tile.eager}
        hidden={tile.hidden}
        lightboxIndex={tile.index}
        title={tile.photo.title}
      />
    ))
  }
</div>
