---
/**
 * The masonry container. Plan 05-07, Task 1. (§7.1, §7.4, §7.5.)
 *
 * ================================================================================================
 * WHY THE `sizes` STRING IS COMPUTED HERE AND NOT IN THE TILE
 * ================================================================================================
 *
 * `sizes` is a property of the LAYOUT, not of the photograph: every tile in one gallery carries the
 * same string, and it depends only on the column count. Computing it once per page also means
 * `sizesFor`'s refusal — it accepts only the column counts `site_config.json` really uses — fires
 * ONCE, at the top of the build, rather than forty times inside a map where the first throw is the
 * only one anybody reads.
 *
 * A `sizes` that disagrees with the stylesheet is a SILENTLY wrong download size: nothing renders
 * incorrectly, the browser just fetches the wrong file. That is why both this file's `data-cols`
 * and `sizesFor`'s arithmetic take the SAME `columns` argument, and why the ladder they encode is
 * gated against the built stylesheet by `scripts/assert-gutter-ladder.mjs`.
 *
 * ================================================================================================
 * `EAGER_TILE_COUNT` — DERIVED FROM THE INDEX, AND CAPPED BY THE LIST
 * ================================================================================================
 *
 * §7.5: `loading="lazy" decoding="async"` on every tile except the first four, which take
 * `loading="eager" fetchpriority="high"` so the LCP candidate is not deferred.
 *
 * "The first four" is a POSITION, so it is read off the index — never a hand-marked flag on a
 * record, which would be a fifth place the manifest's order is encoded and the one nobody updates
 * when a photograph is reordered.
 *
 * IT IS CAPPED BY THE LIST, AND THAT IS NOT A DEFENSIVE FLOURISH. MEASURED: `portraits` and
 * `product` hold TWO photographs each, so a rule stated as "exactly four eager tiles" is false on
 * two of the seven category routes today, and on any category Phase 7 adds before its fourth
 * photograph. `index < EAGER_TILE_COUNT` yields `min(4, n)` structurally, which is the claim that
 * is true on all eight routes.
 */

import PhotoTile from './PhotoTile.astro';
import { GRID_CATEGORY_ATTRIBUTE, GRID_ID, isVisibleIn } from '../../lib/photo-filter';
import { sizesFor } from '../../lib/photo-srcset';
import type { PhotoIdentity, PhotoSources } from '../../lib/photo-srcset';

/** §7.5. The only place this number is written on the rendering side. */
const EAGER_TILE_COUNT = 4;

/**
 * The subset a tile reads. NAMED rather than written inline in `Props`: `astro check` reported both
 * `.map` parameters as implicit `any` when the intersection was spelled inside the interface
 * (MEASURED — `ts(7006)` on `photo` and on `index`), so the callback carries explicit annotations
 * and they need something to refer to. `title` is deliberately absent — see `PhotoTile.astro`.
 */
type GalleryPhoto = PhotoIdentity &
  PhotoSources & {
    readonly alt: string;
    readonly title: string;
    readonly urls: Readonly<Record<string, string>>;
  };

interface Props {
  /**
   * EVERY photograph, on every one of the eight routes — not the route's own subset. Filtering is
   * an attribute now rather than a request, so each document has to contain the whole corpus for
   * there to be anything to reveal. The cost was measured before this was written: a category page
   * goes from 7-15 KB gz to 32 KB gz, and NO extra image bytes, because a `hidden` tile's `lazy`
   * image is never fetched.
   *
   * ALREADY SORTED by the caller, and now by `order` on all eight routes rather than by
   * `categoryOrder` on seven of them. That is safe because it was CHECKED, not assumed: for every
   * one of the seven categories, sorting its members by `order` and by `categoryOrder` yields the
   * identical sequence, so hiding the others preserves each category's curated order exactly.
   * `gate:photo-order` fails the build the day that stops being true.
   */
  photos: readonly GalleryPhoto[];
  /** The category's class-5/6 column count, from `data/site_config.json`. */
  columns: number;
  /**
   * The route's own category, or `ALL`. Decides `data-cols`, which tiles are `hidden`, and which
   * four are eager.
   */
  activeCategory: string;
}

const { photos, columns, activeCategory } = Astro.props;

/*
 * ANTI-VACUITY. A grid rendered over an empty list is a container with no children and no error,
 * and it looks exactly like a gallery whose CSS failed. The two routes each own an explicit empty
 * state (§13.2) and must choose it BEFORE reaching this component, so an empty list arriving here
 * is a caller bug rather than a content state.
 */
if (photos.length === 0) {
  throw new Error(
    'PhotoGrid: rendered with zero photographs. That is not a content state — §13.2 gives the ' +
      'empty gallery its own copy, and the route is what chooses between the two. An empty grid ' +
      'here would ship a page that is silently blank instead of one that explains itself.'
  );
}

/*
 * `id="ph-grid"` — §9.2's selector, added by plan 05-12. It is what `PhotoLightbox`'s single
 * delegated listener attaches to, and it is on the masonry container rather than on the route's
 * wrapper because the listener's job is to see tile clicks and nothing else.
 *
 * An `id` on a reusable component is a claim that only one of it renders per page. MEASURED: both
 * gallery routes render exactly one `PhotoGrid`, and `/photography/<category>` renders it or the empty
 * state, never both. If a page ever needs two grids, the id becomes a prop — the island already
 * takes its selector as one.
 *
 * If the island never arrives — JavaScript off, or the window before `client:idle` fires — the
 * attribute is inert and every tile is still a working link to a prerendered page. That is the
 * mechanism, not a fallback.
 *
 * IT IS WRITTEN HERE AND NOT ABOVE THE ELEMENT, AND THAT IS A MEASURED CONSTRAINT RATHER THAN A
 * PREFERENCE. Placed as the template's FIRST node, an `{ /* ... *\/ }` expression made `astro
 * check` report `ts(6196): 'Props' is declared but never used` against this file — a warning on
 * correct code, on a component whose props are read three lines above. Frontmatter comments never
 * reach the emitted HTML either, so nothing is lost by keeping the note here.
 */

/* Computed once. See the header — and `sizesFor` refuses a column count the site does not use. */
const sizes = sizesFor(columns);

/*
 * EAGER IS COUNTED OVER THE VISIBLE TILES, NOT OVER THE ARRAY. §7.5 loads the first four eagerly
 * for LCP; now that all 40 ship on a category route, "first four in the array" would put all four
 * on photographs the visitor cannot see, and every tile that IS on screen would be lazy. That is a
 * worse LCP than before this change rather than an unchanged one — on the route family whose mobile
 * score is already entirely LCP-bound (87 at 412x823, 05-AUDIT.md §20).
 *
 * So the counter advances only on tiles that are showing.
 */
/*
 * NAMED, for the reason the header already records about `GalleryPhoto`: `astro check` reports the
 * `.map` callback's parameter as implicit `any` (`ts(7006)`) when the row's shape is only inferred,
 * so the second map below needs something to annotate against.
 */
type GalleryTile = {
  readonly photo: GalleryPhoto;
  readonly hidden: boolean;
  readonly eager: boolean;
  readonly index: number;
};

let eagerRemaining = EAGER_TILE_COUNT;
const tiles: readonly GalleryTile[] = photos.map((photo: GalleryPhoto, index: number) => {
  const hidden = !isVisibleIn(photo.category, activeCategory);
  const eager = !hidden && eagerRemaining > 0;
  if (eager) eagerRemaining -= 1;
  return { photo, hidden, eager, index };
});
---

<div
  id={GRID_ID}
  class="ph-masonry"
  data-cols={String(columns)}
  {...{ [GRID_CATEGORY_ATTRIBUTE]: activeCategory }}
>
  {
    tiles.map((tile: GalleryTile) => (
      <PhotoTile
        photo={tile.photo}
        sizes={sizes}
        eager={tile.eager}
        hidden={tile.hidden}
        lightboxIndex={tile.index}
        title={tile.photo.title}
      />
    ))
  }
</div>
