---

import { TILE_CATEGORY_ATTRIBUTE } from '../../lib/photo-filter';
import { photoHref, srcsetFor } from '../../lib/photo-srcset';
import type { PhotoIdentity, PhotoSources } from '../../lib/photo-srcset';

interface Props {
  photo: PhotoIdentity &
    PhotoSources & {
      readonly alt: string;
      readonly urls: Readonly<Record<string, string>>;
    };
  sizes: string;
  eager: boolean;
  lightboxIndex: number;
  hidden: boolean;
  title: string;
}

const { photo, sizes, eager, lightboxIndex, hidden, title } = Astro.props;

if (!Number.isInteger(lightboxIndex) || lightboxIndex < 0) {
  throw new Error(
    `PhotoTile: lightboxIndex on ${JSON.stringify(photo.id)} is ` +
      `${JSON.stringify(lightboxIndex)}, which is not a non-negative integer. It is the tile's ` +
      "position in the island's `items` array; a wrong one opens the lightbox on a different " +
      'photograph than the one that was clicked, on a page that otherwise looks correct.'
  );
}

/**
 * THE LQIP GUARD — T-05-07-01's mitigation, and it is not defensive coding.
 *
 * `thumb` is the one manifest value that lands inside a CSS `url()` rather than in an ordinary
 * attribute. Astro escapes the ATTRIBUTE, which stops a value breaking out of `style="…"` — but a
 * bare apostrophe inside the value would still terminate the `url('…')` token and let everything
 * after it be read as further CSS declarations, inside an attribute the escaper considers clean.
 *
 * `PhotoUrlsSchema` already requires the `data:image/webp;base64,` prefix (`THUMB_PREFIX`). This
 * requires the WHOLE value to be that prefix followed by nothing but the base64 alphabet, so there
 * is no character left that could close the token. Both checks stand: the schema guards the file,
 * this guards the interpolation site, and neither ratifies the other.
 */
if (typeof title !== 'string' || title.trim().length === 0) {
  throw new Error(
    `PhotoTile: title on ${JSON.stringify(photo.id)} is empty, so the hover caption would render ` +
      'an empty scrim over the bottom of the photograph — a grey band with no text, which reads ' +
      'as a rendering fault rather than as missing data.'
  );
}

const THUMB_URI = /^data:image\/webp;base64,[A-Za-z0-9+/]+={0,2}$/;
const thumb = photo.urls.thumb;
if (typeof thumb !== 'string' || !THUMB_URI.test(thumb)) {
  throw new Error(
    `PhotoTile: urls.thumb on ${JSON.stringify(photo.id)} is not a plain base64 WebP data URI. ` +
      'It is interpolated into a CSS `url()` inside the `style` attribute, where a quote or a ' +
      'parenthesis closes the token and everything after it is read as further declarations. ' +
      `Received ${JSON.stringify(String(thumb).slice(0, 48))}…`
  );
}

const medium = photo.urls.medium;
if (typeof medium !== 'string' || medium.length === 0) {
  throw new Error(
    `PhotoTile: urls.medium on ${JSON.stringify(photo.id)} is missing, so the tile would emit ` +
      '`src="undefined"`. A browser resolves that against the page and requests a real URL that ' +
      '404s, which looks like a broken photograph rather than a broken record.'
  );
}

const { width, height } = photo.dimensions;
---

<a
  class="ph-tile"
  href={photoHref(photo)}
  data-lb-index={String(lightboxIndex)}
  {...{ [TILE_CATEGORY_ATTRIBUTE]: photo.category }}
  hidden={hidden}
  style={`aspect-ratio: ${width} / ${height}; background-image: url('${thumb}')`}
>
  <img
    src={medium}
    srcset={srcsetFor(photo)}
    sizes={sizes}
    alt={photo.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
  <!--
    `aria-hidden` because the anchor is already named by the image's `alt` — see the header. A
    visible caption inside a link is otherwise APPENDED to that name, so a screen reader would read
    the full description and then the title again.
  -->
  <span class="ph-tile-caption" aria-hidden="true">{title}</span>
</a>
