---

import { Link } from '@akhil-saxena/design-system/components/Link';
import type { ExperienceEntry } from '../../schemas';
import { formatPeriod } from '../../lib/period';
import { Bullets } from '../Bullets';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;

const period = formatPeriod(entry);
---

<article class="rs-entry">
  <header class="rs-entry-head">
    <div>
      <h3 class="rs-entry-org">
        {
          entry.url ? (
            <Link href={entry.url} variant="quiet" rel="noopener noreferrer">
              {entry.company}
            </Link>
          ) : (
            entry.company
          )
        }
      </h3>
      <p class="rs-entry-role">{entry.role} · {entry.location}</p>
    </div>
    <div class="rs-entry-aside">
      <p class="rs-entry-period">{period}</p>
      <p class="rs-metric">
        <span class="rs-metric-value">{entry.metric.value}</span>
        <span class="rs-metric-label">{entry.metric.label}</span>
      </p>
    </div>
  </header>

  <div class="rs-bullets rs-prose">
    <Bullets items={entry.bullets} />
  </div>
</article>
