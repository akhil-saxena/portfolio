---

import { canonicalPath, SITE_OG_IMAGE, SITE_OG_IMAGE_ALT } from '../../lib/site-meta';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  image = SITE_OG_IMAGE,
  imageAlt = SITE_OG_IMAGE_ALT,
} = Astro.props;

if (!Astro.site) {
  throw new Error(
    'Seo: `Astro.site` is not set, so no canonical or og:url can be made absolute. Set `site` in ' +
      'astro.config.mjs. A relative canonical is honoured by some crawlers and ignored by others, ' +
      'which is worse than none.'
  );
}

if (!canonical.startsWith('/')) {
  throw new Error(
    `Seo: canonical must be a root-relative path beginning with "/", received "${canonical}" ` +
      `(page: ${Astro.url.pathname}). A bare "work" resolves against the CURRENT directory, so ` +
      'the canonical of /photography/architecture/ would silently become /photography/architecture/development.'
  );
}

const normalisedPath = canonicalPath(canonical);

let canonicalUrl: string;
try {
  canonicalUrl = new URL(normalisedPath, Astro.site).href;
} catch (error) {
  throw new Error(
    `Seo: canonical "${canonical}" could not be made absolute against ${Astro.site.href} ` +
      `(page: ${Astro.url.pathname}) — ${error instanceof Error ? error.message : String(error)}`
  );
}

let imageUrl: string;
try {
  imageUrl = new URL(image).href;
} catch {
  throw new Error(
    `Seo: og:image must be an ABSOLUTE URL, received "${image}" (page: ${Astro.url.pathname}). ` +
      'A relative or protocol-relative og:image is ignored by every scraper and produces a card ' +
      'with no picture and no error anywhere. Pass a full https:// URL, or omit the prop and take ' +
      'the site default from src/lib/site-meta.ts.'
  );
}

if (!imageAlt) {
  throw new Error(
    `Seo: og:image:alt is empty (page: ${Astro.url.pathname}). It is the only description a ` +
      'screen-reader user gets of a social card.'
  );
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
