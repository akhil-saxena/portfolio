---
import { Heading } from '@akhil-saxena/design-system/components/Heading';
import { Text } from '@akhil-saxena/design-system/components/Text';
import PublicLayout from '../layouts/PublicLayout.astro';

const WORK_PATH = '/development';
const PHOTOS_PATH = '/photography';
---

<PublicLayout mainClass="pub-max-home">
  <Fragment slot="head">
    {}
    <title>Not found · Akhil Saxena</title>
    <meta name="robots" content="noindex" />
  </Fragment>

  {}
  <div class="nf-page">
    <div class="nf-copy">
      <p class="nf-eyebrow">404 · Not found</p>
      {}
      <Heading level={1} size="4xl" weight="regular" className="nf-title">
        Nothing to see here<span class="nf-stop">.</span>
      </Heading>
      <Text variant="small" className="nf-sub">
        This address holds no page. An empty frame, no photograph in it.
      </Text>
      {}
    </div>

    <div class="nf-frame" aria-hidden="true">
      <span class="nf-frame-label">No image at this address</span>
    </div>
  </div>
</PublicLayout>

<style>
  .nf-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16);
  }

  @media (min-width: 673px) {
    .nf-page {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--space-16);
    }
  }

  .nf-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nf-eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .nf-stop {
    color: var(--ochre-d);
  }

  .nf-sub {
    max-width: min(46ch, 100%);
    padding-block-start: var(--space-5);
  }

  .nf-title {
    padding-block-start: var(--space-1);
  }

  .nf-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 340 / 250;
    border: 1px solid var(--wire);
  }

  .nf-frame::before {
    position: absolute;
    inset: var(--space-3);
    border: 1px dashed var(--rule);
    content: '';
  }

  .nf-frame-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--ink-4);
  }
</style>
