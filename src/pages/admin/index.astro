---
export const prerender = false;

// Not stylistic — structurally required, and it must never be relaxed.
//
// Under output: 'static' this export is the only thing that lets the page run
// server-side logic before any HTML is emitted, which is the only way it can refuse a
// request at the server. A prerendered shell plus a client:only island would render
// perfectly well, but it could never fail closed.
//
// The hard part: a prerendered Astro route cannot read a query string or request
// headers at all. Astro strips them in both dev and build (astro/dist/core/request.js,
// `if (isPrerendered) url.search = ""`). Anything that has to see the
// Cf-Access-Jwt-Assertion header therefore MUST be prerender = false. Auth cannot live
// on a prerendered page, not even temporarily. (FND-02, threat T-02-14)
//
// Protection is prefix-shaped rather than per-file: run_worker_first in wrangler.jsonc
// covers "/admin" and "/admin/*", and src/middleware.ts carries the same four patterns,
// so the five D-05 admin sub-routes arriving in Phase 7 (/admin/home, /admin/photos,
// /admin/resume, /admin/projects, /admin/site) are covered by construction instead of by
// each author remembering a guard. (threat T-02-18)

import { requireAccess } from '@/lib/access';

// Defence in depth, not the primary guard. src/middleware.ts already refuses /admin for
// every request without a verified Cloudflare Access JWT; this call is what still refuses
// it if the middleware's prefix list is ever edited. Plan 02-07's Control C measures that
// the two are genuinely independent rather than one masking the other.
const denied = await requireAccess(Astro.request);
if (denied) return denied;

// Phase 7 owns the admin. This is a doorway that now has a lock and nothing behind it:
// no design-system import, nothing from .playground/, no admin UI. What replaced the
// 503 stub is the lock, not the room.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — akhilsaxena.com</title>
  </head>
  <body>
    <main>
      <h1>Admin</h1>
      <p>
        Cloudflare Access verification passed. The editor itself arrives in Phase 7 — this page
        exists so the door can be locked before there is anything behind it.
      </p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  main {
    max-inline-size: 68ch;
    margin-inline: auto;
    padding: 2rem 1rem;
  }
</style>
