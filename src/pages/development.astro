---
import { getCollection } from 'astro:content';
import rawProjects from '../../data/projects.json';
import PublicLayout from '../layouts/PublicLayout.astro';
import IdentityRail from '../components/public/IdentityRail.astro';
import ProjectCard from '../components/public/ProjectCard.astro';
import Seo from '../components/public/Seo.astro';
import { resume } from '../lib/content';
import { resolveDsTokens } from '../lib/ds-component-count';
import '../styles/development.css';

const WORK_PATH = '/development';

const orderOnDisk = (rawProjects as ReadonlyArray<{ id: string }>).map((record) => record.id);
const projects = (await getCollection('projects'))
  .map((entry) => entry.data)
  .sort((a, b) => orderOnDisk.indexOf(a.id) - orderOnDisk.indexOf(b.id));

if (projects.length === 0) {
  throw new Error(
    'work.astro: the `projects` collection is empty. The file() loader logs a missing or ' +
      'unreadable data/projects.json rather than throwing, so an empty collection here means the ' +
      'file is gone or unparseable, not that there are no projects.',
  );
}

const cards = projects.map((project) => ({
  project,
  description: resolveDsTokens(project.description),
}));

for (const project of projects) resolveDsTokens(project.oneLiner);
---

{}
<PublicLayout mainClass="pub-max-work wk-page">
  <Seo
    slot="head"
    title="Development · Akhil Saxena"
    description="Products shipped on my own, alongside frontend engineering at Brevo."
    canonical={WORK_PATH}
  />

  {}
  {}
  {}
  <div class="wk-split">
    <IdentityRail entries={resume.experience} owns="experience">
      <header class="wk-header" slot="headline">
        {}
        <h1 class="wk-title">Things I design and build<span class="wk-stop">.</span></h1>
        {}
      </header>
    </IdentityRail>

    <div class="wk-main">
      <section class="wk-section">
        <div class="wk-section-head">
          <h2 class="wk-eyebrow">Projects</h2>
        </div>
        <div class="wk-grid">
          {
            cards.map(({ project, description }) => (
              <ProjectCard project={project} description={description} />
            ))
          }
        </div>
      </section>

      {}
    </div>
  </div>
</PublicLayout>
