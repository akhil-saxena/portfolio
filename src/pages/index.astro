---
import { Heading } from '@akhil-saxena/design-system/components/Heading';
import { Button } from '@akhil-saxena/design-system/components/Button';
import { Link } from '@akhil-saxena/design-system/components/Link';
import { home as homeConfig } from '../lib/content';
import PeekGrid from '../components/public/PeekGrid.astro';
import Seo from '../components/public/Seo.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import '../styles/home.css';

const HOME_RENDER_MARKER = 'home-render-ok';

const { title, subtitle, intro, description, ctas } = homeConfig;

const CTA_VARIANT: Record<string, 'primary' | 'secondary'> = {
  primary: 'primary',
  secondary: 'secondary',
};

const homeCtas = ctas.map((cta) => {
  const variant = CTA_VARIANT[cta.style];
  if (!variant) {
    throw new Error(
      `Home: home_config.ctas has style "${cta.style}", which has no Link variant in CTA_VARIANT ` +
        `(${Object.keys(CTA_VARIANT).join(', ')}). Rendering an unstyled anchor would put an ` +
        "unthemed control in the middle of the site's first viewport with nothing to catch it.",
    );
  }
  return { ...cta, variant };
});
---

<PublicLayout mainClass="pub-max-home" navVariant="plain">
  <Seo slot="head" title={`${title} · ${subtitle}`} description={description} canonical="/" />

  <div class="hm-a">
    <Heading
      level={1}
      size={48}
      weight="regular"
      className="hm-name"
      style={{
        fontSize: 'var(--hm-name)',
        lineHeight: 'var(--lh-tight)',
        letterSpacing: 'normal',
      }}
      data-home-marker={HOME_RENDER_MARKER}
    >
      {title}
    </Heading>

    <div class="hm-shed">
      <div class="hm-lede">
        <Heading as="p" size={18} weight="regular" tone="muted" className="hm-subtitle">
          {subtitle}
        </Heading>

        {
          intro.length > 0 && (
            <Heading as="p" size={16} weight="regular" tone="secondary" className="hm-intro">
              {intro}
            </Heading>
          )
        }
      </div>

      <PeekGrid />

      <div class="hm-doors">
        <Button as="a" href="/development" variant="primary" size="lg" className="hm-door">
          Development →
        </Button>
        <Button as="a" href="/photography" variant="secondary" size="lg" className="hm-door">
          Photography →
        </Button>
      </div>

      {
        homeCtas.length > 0 && (
          <div class="hm-ctas">
            {homeCtas.map((cta) => (
              <Button as="a" href={cta.link} variant={cta.variant} size="lg" className="hm-cta">
                {cta.text}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</PublicLayout>
