---
import { Heading } from '@akhil-saxena/design-system/components/Heading';
import { Text } from '@akhil-saxena/design-system/components/Text';
import { getCollection } from 'astro:content';

import homeConfig from '../../../../data/home_config.json';
import siteConfig from '../../../../data/site_config.json';
import { PhotoEmpty } from '../../../components/public/PhotoEmpty';
import { PhotoFilters } from '../../../components/public/PhotoFilters';
import PhotoGrid from '../../../components/public/PhotoGrid.astro';
import Seo from '../../../components/public/Seo.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { COUNT_ID, countLineFor, GRID_ID, TITLE_ID } from '../../../lib/photo-filter';
import '../../../styles/photography.css';

type CategoryRecord = {
  readonly id: string;
  readonly label: string;
  readonly columns: number;
};

export function getStaticPaths() {
  const categories: readonly CategoryRecord[] = siteConfig.categories;

  const paths = categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));

  if (paths.length === 0) {
    throw new Error(
      'photos/[category]: getStaticPaths produced no paths, so Astro would emit NO category route ' +
        'at all — with exit 0. Every filter link would 404 against a build that reported success.',
    );
  }

  return paths;
}

interface Props {
  category: CategoryRecord;
}

const { category } = Astro.props;

const entries = await getCollection('photos');

if (entries.length === 0) {
  throw new Error(
    "photos/[category]: getCollection('photos') returned no entries, so EVERY category would " +
      'render its empty state and the page would report a total of zero. That is a loader ' +
      'failure, not a content state (src/content.config.ts records that the file loader logs and ' +
      'returns rather than throwing).',
  );
}

const all = entries.map((entry) => entry.data);

const photos = [...all].sort((a, b) => a.order - b.order);

const filterPhotos = photos.map((photo) => ({ id: photo.id, category: photo.category }));

const inCategory = all.filter((photo) => photo.category === category.id);

const count = inCategory.length;
const total = all.length;
const siteTitle = homeConfig.title;

const noun = count === 1 ? 'photograph' : 'photographs';

const countLine = countLineFor(category.id, count, total);
---

<PublicLayout mainClass="pub-max-photos">
  <Seo
    slot="head"
    title={`${category.label} photographs · ${siteTitle}`}
    description={`${category.label}: ${count} ${noun} from the gallery of ${total}.`}
    canonical={`/photography/${category.id}`}
  />

  <header class="ph-head">
    <Heading level={1} id={TITLE_ID} size="4xl" weight="regular">{category.label}</Heading>
  </header>

  {}
  <div class="ph-rail">
    {}
    <PhotoFilters
      client:load
      categories={siteConfig.categories}
      photos={filterPhotos}
      pathname={Astro.url.pathname}
      total={total}
      defaultColumns={siteConfig.defaultColumns}
    />

    {}
    <Text size="xs" tone="muted" id={COUNT_ID}>{countLine}</Text>
  </div>

  {}
  {
    count === 0 ? (
      <PhotoEmpty label={category.label} total={total} />
    ) : (
      <Fragment>
        <PhotoGrid photos={photos} columns={category.columns} activeCategory={category.id} />
      </Fragment>
    )
  }
</PublicLayout>
