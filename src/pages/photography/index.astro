---
/**
 * `/photography` — every photograph, one masonry gallery, no pagination. Plan 05-07, Task 2.
 * (PUB-03, PUB-05. §7.1, §8.1, §13.3.)
 *
 * ================================================================================================
 * NO PAGINATION, AND IT IS MEASURED RATHER THAN ASSUMED
 * ================================================================================================
 *
 * §7.1: all `small` variants total 0.86 MB (`medium` 2.96 MB, `large` 5.67 MB). Pagination here is
 * not an optimisation being skipped — it is complexity with no justification. The Phase 0 handoff's
 * "SHOWING 8 OF 39" implies a truncation that does not exist, and this route is what replaces it.
 *
 * ================================================================================================
 * EVERY COUNT IS DERIVED. NO LITERAL APPEARS IN ANY COPY STRING. (§13.3)
 * ================================================================================================
 *
 * The manifest is at 40 and the UI-SPEC says 39 in six places. `getCollection('photos').length` is
 * the only source used here, so the day a 41st photograph lands this page is right without an edit
 * — which is precisely what 03-01's hardcoded `--verify` count was not.
 *
 * ================================================================================================
 * SORTED BY `order`. NEVER BY `date`, AND `date` IS NEVER RENDERED. (§9.4)
 * ================================================================================================
 *
 * The records carry three distinct dates across a corpus of 40 — an ingest window, not a capture
 * history. `REQUIREMENTS.md`'s Out of Scope settled it and plan 05-12 adds the standing gate.
 *
 * ================================================================================================
 * NO `og:image` PROP
 * ================================================================================================
 *
 * 05-06 made `SITE_OG_IMAGE` `<Seo>`'s DEFAULT precisely so no route file has to know about it and
 * no later plan has to edit a route it does not own. Passing one here would be a second definition.
 */

import { Eyebrow } from '@akhil-saxena/design-system/components/Eyebrow';
import { Heading } from '@akhil-saxena/design-system/components/Heading';
import { Link } from '@akhil-saxena/design-system/components/Link';
import { getCollection } from 'astro:content';

import homeConfig from '../../../data/home_config.json';
import siteConfig from '../../../data/site_config.json';
import { PhotoFilters } from '../../components/public/PhotoFilters';
import PhotoGrid from '../../components/public/PhotoGrid.astro';
import { PhotoLightbox } from '../../components/public/PhotoLightbox';
import Seo from '../../components/public/Seo.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { CROSSLINK_TYPE } from '../../lib/crosslink';
import { lightboxRecordsFor } from '../../lib/photo-lightbox';
import '../../styles/photography.css';

/** The cross-link's destination — the work index, and the other half of §13.2's pair. */
const WORK_PATH = '/development';

const entries = await getCollection('photos');

/*
 * ANTI-VACUITY, AND IT IS NOT THEORETICAL. `src/content.config.ts`'s own header records that
 * Astro's `file()` loader LOGS a missing or unparseable file and returns — it does not throw — so an
 * emptied or renamed `data/portfolio_images.json` would leave this collection silently empty. This
 * page would then render "0 PHOTOGRAPHS — ALL OF THEM" over a gallery with nothing in it, which is
 * a true sentence about a broken build. `astro.config.mjs`'s content gate is the other half of this
 * and refuses first; both stand, because neither can ratify the other.
 */
if (entries.length === 0) {
  throw new Error(
    "/photography: getCollection('photos') returned no entries. The manifest is committed content and " +
      'the content gate refuses an empty one, so this means the collection loader could not read ' +
      'data/portfolio_images.json — it logs and returns rather than throwing (see ' +
      'src/content.config.ts). Rendering the gallery over zero records would ship a page that is ' +
      'silently blank and a count that is honestly wrong.',
  );
}

/** §7.1: `/photography` sorts by `order`. MEASURED: dense 1..n across the whole manifest. */
const photos = entries.map((entry) => entry.data).sort((a, b) => a.order - b.order);

const total = photos.length;
const siteTitle = homeConfig.title;

/**
 * The island's props, built at BUILD TIME from the same array `PhotoGrid` renders — so the tile
 * carrying `data-lb-index="7"` and `lightboxItems[7]` are the same photograph by construction
 * rather than by two derivations agreeing. Plan 05-12. (§9.2.)
 */
const lightboxItems = lightboxRecordsFor(photos);
---

<PublicLayout mainClass="pub-max-photos">
  <Seo
    slot="head"
    title={`Photographs — ${siteTitle}`}
    description={`Every photograph on the site in one gallery — all ${total} of them, no pagination.`}
    canonical="/photography"
  />

  <header class="ph-head">
    <Heading level={1}>Photographs</Heading>

    {
      /* `Astro.url.pathname` is passed UN-normalised: normalising is PhotoFilters' job, and it is
        the seam the plan's control flips. See that component's header for why a trailing slash
        here means nothing is marked current, silently. */
    }
    <PhotoFilters
      categories={siteConfig.categories}
      photos={photos}
      pathname={Astro.url.pathname}
    />

    <Eyebrow size="md">{total} photographs — all of them</Eyebrow>
  </header>

  <PhotoGrid photos={photos} columns={siteConfig.defaultColumns} />

  {
    /* 🔴 THE ONE ISLAND ON THIS SITE, AND THE ONLY `client:*` DIRECTIVE OUTSIDE `/photography`. (§5.1.)

      ✅ `client:idle`, NOT `client:load` — measured at last, and the history matters more than
      the answer. The comment that first stood here said "the four Lighthouse numbers behind that
      choice are in `05-12-SUMMARY.md`". MEASURED by 05-15: that file contains the word
      "Lighthouse" ZERO times, and so does every other summary in this phase. 05-12's plan made
      the four numbers a done criterion; they were never taken and the omission was never
      recorded. A claim citing evidence that does not exist is the failure class this phase spent
      itself hunting, and it had a citation pointing at it, which is what made it findable.

      THE RUN HAPPENED, 2026-08-29. `lighthouse@13.4.1`, `npm run audit:lighthouse`, six route
      families x two form factors x four categories, median of three. Full table in
      `05-AUDIT.md` §20. §9.2 is CLOSED.

      THE ANSWER IS THAT `client:idle` BUYS NO SCORE HERE, BECAUSE THERE WAS NONE TO BUY.
      `total-blocking-time` is 0 ms on every route at both form factors, and TBT is the
      30%-weighted metric a hydration cost would appear in. A directive that defers work worth
      0 ms cannot improve a score by deferring it. This agrees with what 05-15 measured without
      installing anything: `client:idle` defers HYDRATION, not download — all three chunks
      (209,206 B) are requested at 25-27 ms, before `domContentLoaded` (24 ms at 1440, 54 ms at
      390) and ~500 ms before the `load` event.

      `client:load` WAS NOT BUILT AND SEPARATELY SCORED, and that is a BOUND rather than a full
      closure. What is measured is that the metric the comparison would move is pinned at its
      floor here, which bounds the difference at zero. Stated as a bound, not as a run.

      SO THE DIRECTIVE STAYS, ON A REASON THAT IS NOT A SCORE: it is the correct expression of
      intent for an island whose entire job begins at a click, and it costs nothing measurable.
      DO NOT "optimise" it to `client:load` — the two are indistinguishable here and the change
      would be churn against a reviewed decision.

      WHAT DOES COST THIS PAGE A SCORE IS NOT THIS DIRECTIVE. `/photography` scores 87 on mobile and
      99 on desktop, and the ENTIRE mobile deficit is LCP (4.0 s at weight 25; TBT, CLS and Speed
      Index all score 1.00). The cause is in the GRID, not here: §7.5 eagerly loads the first four
      tiles BY DOM ORDER, and the masonry is CSS multi-column, which fills column 1 with DOM 0-19
      and column 2 with DOM 20-39. So at 412x823 the four eager tiles are the top four of the LEFT
      column and nothing in the right one is eager — 9 tiles are in the first screen, 5 of them
      lazy, and the largest (dom#23, 174x261 against its neighbours' 174x116) is the LCP element.
      Measured in `05-AUDIT.md` §20, with four options and their costs.

      NOTHING WAS CHANGED ANYWHERE TO IMPROVE A SCORE. The fix amends a reviewed spec clause and
      trades desktop bytes for mobile latency; that is Akhil's call, not the executor's.

      THE GRID IS NOT HYDRATED. There is no `client:*` on `PhotoGrid` or on `PhotoTile`, and there
      must never be: the island takes a SELECTOR and attaches one delegated listener to static
      Astro HTML. That is what keeps every tile a working link with JavaScript off and in the
      window before this island idles — PUB-04's crawlability, PUB-06's lightbox, PUB-09's per-photo
      page and the Back button, from one decision.

      `items` is JSON — an island's props are serialised into the document, so a `ReactNode` cannot
      be built here. The caption is composed inside the island from `exifRows`. */
  }
  <PhotoLightbox client:idle items={lightboxItems} gridSelector="#ph-grid" />

  {
    /* §13.2 — THE RETURNING HALF OF THE CROSS-LINK PAIR, AND IT WAS NEVER BUILT UNTIL NOW.

      `/development` has shipped *see the photographs →* since 05-09, asserted character for character.
      §13.2's next row is *← see the work* on `/photography`, and 05-15's audit found that
      `grep -rn "see the work"` over the whole repository returned exactly ONE line — the spec row
      itself. No gate caught it because §13.2 is prose. Akhil decided to build it rather than drop
      the row.

      THE TREATMENT IS `/development`'s, NOT A SECOND ONE. `CROSSLINK_TYPE` is the same object that page
      imports (`src/lib/crosslink.ts`), so the two halves cannot drift into two italic serifs; the
      only thing this file declares is the row's own layout, in `photos.css`.

      IT IS INTERNAL, so it carries no `target` and no `rel` — the new-tab announcement and the
      tabnabbing guard belong to outbound anchors and to nothing else. That is the same reasoning
      `work.astro` states at its half.

      ON `/photography` ONLY, and that is the pair §13.2 names: `/development` ↔ `/photography`. The seven
      `/photography/<category>` routes are filtered views of this gallery and get the return path from
      the AppBar, exactly as `/development` does — a cross-link on each of them would be seven copies of
      one editorial gesture. `test/public/photography-routes.node.test.ts` asserts BOTH halves of that:
      exactly one row here, and zero on every category route, so the decision is a red test if it
      is ever changed by accident rather than on purpose. */
  }
  <p class="ph-crosslink-row">
    <Link className="ph-crosslink" href={WORK_PATH} variant="quiet" style={CROSSLINK_TYPE}>
      ← see the work
    </Link>
  </p>
</PublicLayout>
