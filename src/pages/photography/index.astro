---
/**
 * `/photography` — every photograph, one masonry gallery, no pagination. Plan 05-07, Task 2.
 * (PUB-03, PUB-05. §7.1, §8.1, §13.3.)
 *
 * ================================================================================================
 * NO PAGINATION, AND IT IS MEASURED RATHER THAN ASSUMED
 * ================================================================================================
 *
 * §7.1: all `small` variants total 0.86 MB (`medium` 2.96 MB, `large` 5.67 MB). Pagination here is
 * not an optimisation being skipped — it is complexity with no justification. The Phase 0 handoff's
 * "SHOWING 8 OF 39" implies a truncation that does not exist, and this route is what replaces it.
 *
 * ================================================================================================
 * EVERY COUNT IS DERIVED. NO LITERAL APPEARS IN ANY COPY STRING. (§13.3)
 * ================================================================================================
 *
 * The manifest is at 40 and the UI-SPEC says 39 in six places. `getCollection('photos').length` is
 * the only source used here, so the day a 41st photograph lands this page is right without an edit
 * — which is precisely what 03-01's hardcoded `--verify` count was not.
 *
 * ================================================================================================
 * SORTED BY `order`. NEVER BY `date`, AND `date` IS NEVER RENDERED. (§9.4)
 * ================================================================================================
 *
 * The records carry three distinct dates across a corpus of 40 — an ingest window, not a capture
 * history. `REQUIREMENTS.md`'s Out of Scope settled it and plan 05-12 adds the standing gate.
 *
 * ================================================================================================
 * NO `og:image` PROP
 * ================================================================================================
 *
 * 05-06 made `SITE_OG_IMAGE` `<Seo>`'s DEFAULT precisely so no route file has to know about it and
 * no later plan has to edit a route it does not own. Passing one here would be a second definition.
 */

import { Heading } from '@akhil-saxena/design-system/components/Heading';
import { Text } from '@akhil-saxena/design-system/components/Text';
import { Link } from '@akhil-saxena/design-system/components/Link';
import { getCollection } from 'astro:content';

import homeConfig from '../../../data/home_config.json';
import siteConfig from '../../../data/site_config.json';
import { PhotoFilters } from '../../components/public/PhotoFilters';
import PhotoGrid from '../../components/public/PhotoGrid.astro';
import Seo from '../../components/public/Seo.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { ALL, COUNT_ID, countLineFor, GRID_ID, TITLE_ID } from '../../lib/photo-filter';
import '../../styles/photography.css';

const entries = await getCollection('photos');

/*
 * ANTI-VACUITY, AND IT IS NOT THEORETICAL. `src/content.config.ts`'s own header records that
 * Astro's `file()` loader LOGS a missing or unparseable file and returns — it does not throw — so an
 * emptied or renamed `data/portfolio_images.json` would leave this collection silently empty. This
 * page would then render "0 PHOTOGRAPHS — ALL OF THEM" over a gallery with nothing in it, which is
 * a true sentence about a broken build. `astro.config.mjs`'s content gate is the other half of this
 * and refuses first; both stand, because neither can ratify the other.
 */
if (entries.length === 0) {
  throw new Error(
    "/photography: getCollection('photos') returned no entries. The manifest is committed content and " +
      'the content gate refuses an empty one, so this means the collection loader could not read ' +
      'data/portfolio_images.json — it logs and returns rather than throwing (see ' +
      'src/content.config.ts). Rendering the gallery over zero records would ship a page that is ' +
      'silently blank and a count that is honestly wrong.',
  );
}

/** §7.1: `/photography` sorts by `order`. MEASURED: dense 1..n across the whole manifest. */
const photos = entries.map((entry) => entry.data).sort((a, b) => a.order - b.order);

const total = photos.length;

/**
 * WHAT THE ISLAND IS HANDED: an identity per photograph, not a record.
 *
 * `PhotoFilters` reads one field — `category`, for the pill group-by. Passing the records themselves
 * serialised ten fields of forty photographs into the `props` attribute: MEASURED at 58,180 bytes,
 * 43.8% of the built document, on every gallery route. This projection is 2,302 bytes.
 *
 * `id` rides along unused on purpose; see the prop's own doc comment for why an identity array is
 * worth 2KB over a bare count map.
 */
const filterPhotos = photos.map((photo) => ({ id: photo.id, category: photo.category }));

const siteTitle = homeConfig.title;

/**
 * The island's props, built at BUILD TIME from the same array `PhotoGrid` renders — so the tile
 * carrying `data-lb-index="7"` and `lightboxItems[7]` are the same photograph by construction
 * rather than by two derivations agreeing. Plan 05-12. (§9.2.)
 */
---

<PublicLayout mainClass="pub-max-photos">
  <Seo
    slot="head"
    title={`Photographs · ${siteTitle}`}
    description={`Every photograph on the site in one gallery, all ${total} of them, no pagination.`}
    canonical="/photography"
  />

  <header class="ph-head">
    <Heading level={1} id={TITLE_ID} size="4xl" weight="regular">Photographs</Heading>
  </header>

  {
    /*
     * THE RAIL IS A SIBLING OF THE HEADER, NOT A CHILD, AND THAT IS A CSS CONSTRAINT RATHER THAN A
     * SEMANTIC PREFERENCE.
     *
     * `.ph-rail` is `position: sticky`, and a sticky box CANNOT LEAVE ITS CONTAINING BLOCK. Nested
     * inside `<header class="ph-head">` — a box about 110px tall — it would unstick the moment the
     * header scrolled past, which is roughly immediately. Its parent has to be the tall one, so its
     * parent is `.pub-main`.
     *
     * The `<h1>` stays unpinned on purpose. Akhil, watching the whole block hop 24px and lock:
     * *"when i scroll the photographs heading scrolls a bit up, is that needed?"* It is not — the
     * heading repeats what the bar already says (`photography` is the current nav item), and
     * leaving it behind gives the photographs ~40px more of the viewport while scrolling. The rail
     * is the part worth pinning: it is a control, not a label.
     */
  }
  <div class="ph-rail">
    {
      /* `Astro.url.pathname` is passed UN-normalised: normalising is PhotoFilters' job, and it is
        the seam the plan's control flips. See that component's header for why a trailing slash
        here means nothing is marked current, silently. */
    }
    <PhotoFilters
      client:load
      categories={siteConfig.categories}
      photos={filterPhotos}
      pathname={Astro.url.pathname}
      total={total}
      defaultColumns={siteConfig.defaultColumns}
    />

    {
      /* DERIVED, not written here. This template used to spell the string itself while
         `photo-filter.ts` held a second copy for the client to switch to — two spellings of one
         sentence, which is how the server view and the switched view drift apart. */
    }
    {
      /*
       * `Text`, NOT `Eyebrow`, and the swap is the fix rather than a smaller size.
       *
       * Akhil: *"text - 40 photographs needs not be bold, reduce size, not very prominent. current
       * taking away from existing website."* MEASURED, the `Eyebrow` was carrying FOUR prominence
       * signals simultaneously — `font-weight: 700`, `text-transform: uppercase`,
       * `letter-spacing: 1.1px` and `IBM Plex Mono` — at 11px. Shrinking it would have left all
       * four; `Eyebrow` is a label component and that is the job it does correctly.
       *
       * `Text size="xs" tone="muted"` is 11px in the body face at normal weight, sentence case, no
       * tracking, `--ink-3`. Same size, none of the shouting. The pills beside it are the thing on
       * this row worth noticing.
       */
    }
    <Text size="xs" tone="muted" id={COUNT_ID}>{countLineFor(ALL, total, total)}</Text>
  </div>

  <PhotoGrid photos={photos} columns={siteConfig.defaultColumns} activeCategory={ALL} />

  {
    /*
     * photograph as an overlay. Akhil replaced it: *"build this in place of lightbox, allow nav,
     * scroll etc."* — the M4 photo page IS the photo view now, and every tile is already a real
     * link to it. Removing the island removes a delegated click handler that was PREVENTING that
     * navigation with `preventDefault()`.
     *
     * The filter's controller moved with it. It lived inside the lightbox island because
     * `gate:public-js` permits one island per document; with the island gone it needs a host, and
     * `PhotoFilters` is hydrated directly instead — same delegated listener, same contract, one
     * island still.
     */
  }

  {
    /*
     * NO CROSS-LINK TO /development. Akhil: *"remove ← see the work from photographs page."*
     *
     * IT WAS §13.2's OTHER HALF, so this is a spec row being retired rather than a line being
     * tidied away. `/development` has shipped *see the photographs →* since 05-09, asserted
     * character for character, and this page carried *← see the work* as its return. The pair is
     * now one-directional.
     *
     * WHAT REPLACES IT: the bar. Both destinations are two of its three items and the current one
     * is marked, so `/development` is one click from here either way — which is what makes the
     * editorial row optional rather than load-bearing. It also removes the last thing on this page
     * that pointed away from the photographs.
     *
     * TWO ASSERTIONS GO RED UNTIL THEY ARE UPDATED, and they should be updated rather than deleted:
     * `test/public/photography-routes.node.test.ts` asserts exactly one such row here and zero on
     * every category route, and the copy contract pins the string. The first is now "zero here and
     * zero there"; the second is a retired pin. Both are recorded in the deferred test work.
     */
  }
</PublicLayout>
