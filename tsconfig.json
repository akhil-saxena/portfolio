{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*", "worker-configuration.d.ts"],
  // Nothing under `test/` is excluded, and that is the point. Plan 02-05 had to exclude
  // exactly one file here — `test/setup/preview-server.ts`, the first Node-side source in
  // the repository — because `@types/node` was absent, so every `node:child_process` /
  // `node:fs` / `node:path` / `node:url` / `node:module` import failed to resolve and
  // `astro check` reported 12 errors, which breaks `npm run build` (the build script chains
  // `astro check`). 02-05 could not install the fix: its threat register said it installs
  // nothing, and a lockfile change would have collided with its wave.
  //
  // Plan 02-06 added `@types/node` (audited in 02-PACKAGE-AUDIT.md) and deleted the
  // exclusion. Do not reintroduce a `test/**` exclusion to silence a type error — an
  // excluded file is a file the build no longer checks, and the auth suite lives there.
  "exclude": ["dist", "node_modules", ".playground", ".wrangler", "design_handoff_portfolio"]
}
