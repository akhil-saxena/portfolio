// Cloudflare Workers with Static Assets. Not Pages — @astrojs/cloudflare removed Pages
// support in v13 and no flag restores it.
//
// Every key below was validated against node_modules/wrangler/config-schema.json (the
// installed schema, not the docs) rather than copied from a tutorial.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Required, not optional: @cloudflare/vite-plugin reads it during `astro dev`, and
  // `wrangler deploy` derives the Worker's identity from it.
  "name": "akhilsaxena-portfolio",

  // The old "dist/_worker.js/index.js" value is dead. Astro's *deploy* guide still
  // shows it; the *adapter* guide documents the change and is authoritative.
  "main": "@astrojs/cloudflare/entrypoints/server",

  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Needs a dist/404.html to serve, which src/pages/404.astro provides.
    "not_found_handling": "404-page"
  },

  // The non-apex hostname decided in plan 02-02 (see 02-DNS-R2-PREREQS.md ->
  // WORKER_CUSTOM_DOMAIN). custom_domain: true makes `wrangler deploy` create and
  // attach the hostname itself — no dashboard step, no redeploy dance. Without it the
  // Worker is reachable only on *.workers.dev, where Cloudflare Access cannot be
  // applied, and the production auth verification in plans 02-09/02-10 would have
  // nothing to run against.
  //
  // The apex akhilsaxena.com is deliberately NOT attached here. Cutover owns it.
  "routes": [{ "pattern": "akhilsaxena.com", "custom_domain": true }],

  // Kept although no runtime code reads it: `photo-pipeline-contract.unit.test.ts` asserts
  // STAGING_BUCKET byte-equal to this name, so this file is where the Actions pipeline's bucket
  // name is declared. Removing it reddened three tests.
  "r2_buckets": [{ "binding": "PORTFOLIO_BUCKET", "bucket_name": "portfolio-photos" }]

  // Deliberately absent:
  //   - analytics_engine_datasets / PHOTO_ANALYTICS. Dropping it is what keeps the
  //     public pages fully static; photo analytics is out of scope per PROJECT.md.
  //   - a "vars" block. This comment used to predict that Phase 3's CONT-04 would add
  //     R2_PUBLIC_URL here alongside the manifest rewrite. Plan 03-01 checked that
  //     prediction instead of obeying it, and it was wrong: nothing in Phase 3 reads
  //     the value at runtime. The manifest holds absolute URLs resolved at build time,
  //     and the only producer of new ones is the Phase 4 Actions pipeline, which runs on
  //     a Node runner and never inside the Worker. Since astro.config.mjs sets
  //     validateSecrets: true, declaring the var now would turn a value nothing reads
  //     into a build failure until someone provisions it.
  //
  //     The canonical image origin therefore lives in src/lib/image-origin.ts, which the
  //     manifest migration and the CONT-04 gate both import — one place, so they cannot
  //     disagree with the data. Phase 4 adds the var here when its pipeline becomes a
  //     real consumer, with that constant as the build-time default rather than a second
  //     source of truth.
}
